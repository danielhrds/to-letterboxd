{
  "manifest_version": 3,
  "name": "To Letterboxd",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.3",
  "minimum_chrome_version": "123",
  "default_locale": "en",
  "permissions": ["storage", "contextMenus"],
  "optional_host_permissions": ["https://api.themoviedb.org/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "assets/icons/16.png", "32": "assets/icons/32.png" }
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com.br/search*"
      ],
      "js": ["src/content/main.js"],
      "css": ["src/content/styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/google.js",
        "src/core/urls.js",
        "src/core/film-input.js",
        "src/core/messages.js",
        "_locales/en/messages.json",
        "_locales/pt_BR/messages.json",
        "assets/icons/16.png"
      ],
      "matches": ["https://www.google.com/*", "https://www.google.com.br/*"]
    }
  ]
}
